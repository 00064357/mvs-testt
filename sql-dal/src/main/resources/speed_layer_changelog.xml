    <changeSet id="2" author="Dmitriy Kozhin">
        <!--Create sl.sp_TruncateOldPartitions procedure-->
        <sql dbms="mssql">
            CREATE PROCEDURE [sl].[sp_TruncateOldPartitions]
                @factTableNameIdx SMALLINT = 1,
                @keepDays SMALLINT = 7,
                @mixinCurrentDate DATETIME = NULL
            AS
            BEGIN
                SET NOCOUNT ON

                IF (ISNULL(@factTableNameIdx, -1) &lt; 1  OR @factTableNameIdx &gt; 2)
                BEGIN
                    RAISERROR('Invalid parameter: @factTableNameIdx cannot be NULL or non-positive or greater than 2.', 18, 0)
                    RETURN
                END

                IF (ISNULL(@keepDays, -1) &lt; 1  OR @keepDays &gt; 364)
                BEGIN
                    RAISERROR('Invalid parameter: @keepDays cannot be NULL or non-positive or greater than 364.', 18, 0)
                    RETURN
                END

                DECLARE @currentDate DATETIME = ISNULL(@mixinCurrentDate, GETUTCDATE())
                DECLARE @currentDayNumber SMALLINT = DATEPART(dy, @currentDate)

                DECLARE @lowerBound SMALLINT = 1
                DECLARE @upperBound SMALLINT = DATEPART(dy, DATEADD(DAY, -@keepDays, @currentDate))

                IF (@currentDayNumber &lt;= @upperBound)
                BEGIN
                    SET @lowerBound = @currentDayNumber + 1
                END

                DECLARE @tableName SYSNAME = CASE @factTableNameIdx
                    WHEN 1 THEN 'SpeedLayerPosition'
                    WHEN 2 THEN 'SpeedLayerEvent'
                END
                SET @tableName = '[sl].' + QUOTENAME(@tableName)

                PRINT 'Truncating table ' + @tableName + ' to keep '
                + CAST(@keepDays AS VARCHAR) + ' days of data starting with day of year '
                + CAST(@upperBound AS VARCHAR) + ' ('
                + CAST(DATEADD(DAY, -@keepDays, @currentDate) AS VARCHAR) + ')'

                DECLARE @sql nvarchar(4000)
                SET @sql = 'TRUNCATE TABLE ' + @tableName + ' WITH (PARTITIONS(@partition))'

                DECLARE @partition SMALLINT = @lowerBound
                WHILE @partition &lt; @upperBound
                BEGIN
                    EXEC sys.sp_executesql @sql, N'@partition SMALLINT', @partition = @partition
                    PRINT 'Truncated partition ' + CAST(@partition AS VARCHAR)

                    SET @partition = @partition + 1
                END

                RETURN 0
            END
        </sql>
    </changeSet>

