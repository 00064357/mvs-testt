    <changeSet id="4" author="Valerii Florov">
        <!--udf -->
        <sql dbms="mssql" splitStatements="false" endDelimiter=";">
            CREATE FUNCTION [dbo].[udf_GetDistanceKm]
            (@lat1deg  [REAL]
            , @long1deg [REAL]
            , @lat2deg  [REAL]
            , @long2deg [REAL]
            )
            RETURNS FLOAT
            AS
            BEGIN
            DECLARE @Result FLOAT = 0;
            DECLARE @cEathR FLOAT = 6371.0;
            IF @lat1deg IS NOT NULL
            AND @long1deg IS NOT NULL
            AND @lat2deg IS NOT NULL
            AND @long2deg IS NOT NULL
            BEGIN
            DECLARE @cPi FLOAT = PI();
            DECLARE @lat1rad  FLOAT = RADIANS(@lat1deg)
            , @long1rad FLOAT = RADIANS(@long1deg)
            , @lat2rad  FLOAT = RADIANS(@lat2deg)
            , @long2rad FLOAT = RADIANS(@long2deg);
            DECLARE @halfDeltaLat  FLOAT = (@lat2rad - @lat1rad) / 2.0
            , @halfDeltaLong FLOAT = (@long2rad - @long1rad) / 2.0;

            DECLARE @a FLOAT = SQUARE(SIN(@halfDeltaLat)) + COS(@lat1rad) * COS(@lat2rad) * SQUARE(SIN(@halfDeltaLong));
            SET @result = @cEathR * 2.0 * ATN2(SQRT(@a), SQRT(1.0 - @a));
            END;
            RETURN @Result;
            END;
        </sql>

        <!-- stored procedure-->
        <sql dbms="mssql" splitStatements="false" endDelimiter=";">
            CREATE PROCEDURE [dbo].[sp_GetNearbyVehicles]
            (
            @latitude      FLOAT
            , @longitude     FLOAT
            , @from          DATETIME
            , @to            DATETIME
            , @radiusMeters  FLOAT
            , @maxItemsCount INT
            )
            AS
            BEGIN
            SET NOCOUNT ON;
            DECLARE @observed_day_min SMALLINT = DATEPART(dayofyear, @from)
            , @observed_day_max SMALLINT = DATEPART(dayofyear, @to);
            WITH T(
            [SubscriptionId]
            , [VehicleId]
            , [DriverId]
            , [ObservedDay]
            , [Time]
            , [DistanceKm]
            )
            AS (
            SELECT
            p.SubscriptionId
            , p.VehicleDurableKey
            , p.DriverDurableKey
            , p.ObservedDay
            , p.Timestamp
            , [dbo].udf_GetDistanceKm(p.[Latitude], p.[Longitude], @latitude, @longitude) AS [DistanceKm]
            FROM
            [sl].[SpeedLayerPosition] p
            )
            SELECT TOP (@maxItemsCount)
            t.[SubscriptionId]
            , t.[VehicleId]
            , t.[DriverId]
            , MIN(t.[DistanceKm]) AS DistanceKmMin
            , MAX(t.[DistanceKm]) AS DistanceKmMax
            , MIN(t.[Time]) AS TimeMin
            , MAX(t.[Time]) AS TimeMax
            FROM
            t
            WHERE 1 = 1
            AND t.[ObservedDay] BETWEEN @observed_day_min AND @observed_day_max
            AND t.[DistanceKm] &lt;= @radiusMeters / 1000.0
            AND t.[Time] BETWEEN @from AND @to
            GROUP BY
            t.[SubscriptionId]
            , t.[VehicleId]
            , t.[DriverId]
            ORDER BY
            MIN(t.[DistanceKm])
            , MIN(t.[Time]);
            END;
        </sql>
    </changeSet>

