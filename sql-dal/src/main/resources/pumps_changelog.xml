<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd"
        logicalFilePath="pumps_changelog.xml">


    <!-- Init the pumps database  -->
    <changeSet id="1" author="Valerii Florov">

        <!--CREATE TABLE [cfg].[Account] (-->
        <!--[ID] BIGINT IDENTITY (1, 1) NOT NULL,-->
        <!--[AccountName] [varchar](255) NOT NULL,-->
        <!--[AccountKeyVaultName] [varchar](255) NOT NULL,-->
        <!--[IsActive] [bit] NOT NULL DEFAULT ((0)),-->
        <!--CONSTRAINT [PK_cfg.Account] PRIMARY KEY CLUSTERED ([ID] ASC)-->
        <!--);-->
        <createTable schemaName="cfg" tableName="Account" remarks="Contains accounts to access to MIX API.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="AccountName" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="AccountKeyVaultName" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="IsActive" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>


        <!--CREATE TABLE [cfg].[AccountTokens] (-->
        <!--[ID] BIGINT IDENTITY (1, 1) NOT NULL,-->
        <!--[AccountId] BIGINT NOT NULL,-->
        <!--[AccessToken] [varchar](1500) NULL,-->
        <!--[RefreshToken] [varchar](1500) NULL,-->
        <!--[LastSyncDateUtc]               DATETIME2 (7) NULL,-->
        <!--[ExpirationDateUtc]               DATETIME2 (7) NULL,-->
        <!--CONSTRAINT [PK_cfg.AccountTokens] PRIMARY KEY CLUSTERED ([ID] ASC),-->
        <!--CONSTRAINT [FK_cfg.AccountTokens_cfg.Account_AccountId] FOREIGN KEY ([AccountId]) REFERENCES [cfg].[Account] ([ID]) ON DELETE CASCADE-->
        <!--);-->
        <createTable schemaName="cfg" tableName="AccountTokens" remarks="Contains accounts tokens to access to MIX API.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="AccountId" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="AccessToken" type="varchar(1500)">
                <constraints nullable="true"/>
            </column>
            <column name="RefreshToken" type="varchar(1500)">
                <constraints nullable="true"/>
            </column>
            <column name="LastSyncDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="ExpirationDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="AccountTokens_Account_AccountId"
                                 baseTableSchemaName="cfg"
                                 baseTableName="AccountTokens"
                                 baseColumnNames="AccountId"
                                 referencedTableSchemaName="cfg"
                                 referencedTableName="Account"
                                 referencedColumnNames="ID"
                                 onDelete="CASCADE" />


        <!--CREATE TABLE [cfg].[OrganisationGroup] (-->
        <!--[ID] BIGINT IDENTITY (1, 1) NOT NULL,-->
        <!--[AccountId] BIGINT NOT NULL,-->
        <!--[GroupId] BIGINT NOT NULL,-->
        <!--[Type] [varchar](255) NULL,-->
        <!--[DisplayTimeZone] [varchar](255) NULL,-->
        <!--[Name] [varchar](255) NULL,-->
        <!--[IsActive] [bit] NOT NULL DEFAULT ((0)),-->
        <!--CONSTRAINT [PK_cfg.OrganisationGroup] PRIMARY KEY CLUSTERED ([ID] ASC),-->
        <!--CONSTRAINT [FK_cfg.OrganisationGroup_cfg.Account_AccountId] FOREIGN KEY ([AccountId]) REFERENCES [cfg].[Account] ([ID]) ON DELETE CASCADE-->
        <!--);-->
        <createTable schemaName="cfg" tableName="OrganisationGroup" remarks="Contains description of organisation groups.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="AccountId" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="GroupId" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="Type" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="DisplayTimeZone" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="Name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="IsActive" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="OrganisationGroup_Account_AccountId"
                                 baseTableSchemaName="cfg"
                                 baseTableName="OrganisationGroup"
                                 baseColumnNames="AccountId"
                                 referencedTableSchemaName="cfg"
                                 referencedTableName="Account"
                                 referencedColumnNames="ID"
                                 onDelete="CASCADE" />


