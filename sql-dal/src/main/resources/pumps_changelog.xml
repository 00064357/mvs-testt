        </createTable>
    </changeSet>

    <changeSet id="2" author="Valerii Florov">

        <createTable schemaName="cfg" tableName="HiveOffset" remarks="Contains offsets for hive (orc files).">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="EntityType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="TimeFrom" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="TimeTo" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="IngestedDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="PreparedDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="ElementCount" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="3" author="Valerii Florov">
        <dropColumn schemaName="cfg"
                    tableName="HiveOffset"
                    columnName="TimeFrom"/>

        <dropColumn schemaName="cfg"
                    tableName="HiveOffset"
                    columnName="TimeTo"/>

        <renameColumn schemaName="cfg"
                      tableName="HiveOffset"
                      columnDataType="datetime2(7)"
                      oldColumnName="IngestedDateUtc"
                      newColumnName="PersistedDateUtc"/>

        <addColumn schemaName="cfg"
                   tableName="HiveOffset">
            <column name="WeekNumber" type="int"/>
        </addColumn>

        <addColumn schemaName="cfg"
                   tableName="HiveOffset">
            <column name="Year" type="int"/>
        </addColumn>

        <createIndex indexName="UX_HiveOffset_EntityType_PreparedDateUtc"
                     schemaName="cfg"
                     tableName="HiveOffset"
                     unique="false">

            <column name="EntityType" type="int"/>
            <column name="PreparedDateUtc" type="datetime2(7)"/>
        </createIndex>
    </changeSet>

    <changeSet id="4" author="Valerii Florov">
        <dropColumn schemaName="cfg"
                    tableName="HiveOffset"
                    columnName="WeekNumber"/>

        <dropColumn schemaName="cfg"
                    tableName="HiveOffset"
                    columnName="Year"/>
    </changeSet>

    <changeSet id="5" author="Dmitriy Kozhin">
        <addColumn schemaName="cfg"
                   tableName="HiveOffset">
            <column name="ValidatedDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="6" author="Dmitriy Kozhin">
        <createTable schemaName="cfg" tableName="ValidatedEventTachoOffset" remarks="Contains offsets for tacho facts.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SyncDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="FromPersistedDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="ToPersistedDateUtc" type="datetime2(7)">
                <constraints nullable="true"/>
            </column>
            <column name="ElementCount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="SyncDuration" type="time(5)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="6-tag" author="Dmitriy Kozhin">
        <tagDatabase tag="version_0.1.0"/>
    </changeSet>

</databaseChangeLog>