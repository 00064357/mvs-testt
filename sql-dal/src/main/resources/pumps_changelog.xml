<!--        GO-->
<!--        CREATE UNIQUE NONCLUSTERED INDEX [UX_MixOffset_OrganisationGroupIdAndCodes]-->
<!--        ON [cfg].[MixOffset]([OrganisationGroupId] ASC, [EntityType] ASC);        -->
        <createTable schemaName="cfg" tableName="MixOffset" remarks="Contains offsets for external pumps.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="OrganisationGroupId" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="EntityType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EntitySuperType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="LastSyncDateUtc" type="datetime2(5)">
                <constraints nullable="true"/>
            </column>
            <column name="LastProcessedTime" type="datetime2(5)">
                <constraints nullable="false"/>
            </column>
            <column name="LastSyncResultCode" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="LastSyncElementCount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="LastSyncDuration" type="time(5)">
                <constraints nullable="false"/>
            </column>
            <column name="TotalElementsCount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="LastErrorMessage" type="varchar(8000)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="MixOffset_OrganisationGroup_OrganisationGroupId"
                                 baseTableSchemaName="cfg"
                                 baseTableName="MixOffset"
                                 baseColumnNames="OrganisationGroupId"
                                 referencedTableSchemaName="cfg"
                                 referencedTableName="OrganisationGroup"
                                 referencedColumnNames="ID"
                                 onDelete="CASCADE"/>

        <createIndex indexName="UX_MixOffset_OrganisationGroupIdAndCodes"
                     schemaName="cfg"
                     tableName="MixOffset"
                     unique="true">

            <column name="OrganisationGroupId" type="bigint"/>
            <column name="EntityType" type="int"/>
        </createIndex>

        <!--CREATE TABLE [cfg].[EventHubOffset] (-->
        <!--[ID] BIGINT IDENTITY (1, 1) NOT NULL,-->
        <!--[PartitionId] INT NOT NULL,-->
        <!--[EntityType] INT NOT NULL,-->
        <!--[EntitySuperType] INT NOT NULL,-->
        <!--[SeqNo] BIGINT NOT NULL,-->
        <!--[LastSyncDateUtc] DATETIME2(5) NULL,-->
        <!--[LastSyncElementCount] BIGINT NOT NULL,-->
        <!--[TotalElementsCount] BIGINT NOT NULL,-->
        <!--CONSTRAINT [PK_cfg.EventHubOffset] PRIMARY KEY CLUSTERED ([ID] ASC)-->
