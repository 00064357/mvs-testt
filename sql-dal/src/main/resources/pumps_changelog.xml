            </column>
        </createTable>

        <!--CREATE TABLE [cfg].[Signal] (-->
        <!--[ID] BIGINT IDENTITY (1, 1) NOT NULL,-->
        <!--[ApplicationType] INT NOT NULL,-->
        <!--[ApplicationSuperType] INT NOT NULL,-->
        <!--[EntityType] INT NULL,-->
        <!--[EntitySuperType] INT NULL,-->
        <!--[Timestamp] DATETIME2(5) NULL,-->
        <!--[SignalType] INT NOT NULL,-->
        <!--[Message] VARCHAR(100) NULL,-->
        <!--CONSTRAINT [PK_cfg.Signal] PRIMARY KEY CLUSTERED ([ID] ASC)-->
        <!--);-->
        <createTable schemaName="cfg" tableName="Signal" remarks="Contains signals that used to control spark application.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ApplicationType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="ApplicationSuperType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EntityType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EntitySuperType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="Timestamp" type="datetime2(5)">
                <constraints nullable="false"/>
            </column>
            <column name="SignalType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="Message" type="varchar(100)">
                <constraints nullable="false"/>
