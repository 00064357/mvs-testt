        <createTable schemaName="cfg" tableName="EventHubOffset" remarks="Contains offsets for event hub.">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PartitionId" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EntityType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EntitySuperType" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="SeqNo" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="LastSyncDateUtc" type="datetime2(5)">
                <constraints nullable="true"/>
            </column>
            <column name="LastSyncElementCount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="TotalElementsCount" type="bigint">
